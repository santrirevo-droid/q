{"page":574,"ayahs":[{"number":5476,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ يَٰٓأَيُّهَا ٱلْمُزَّمِّلُ","numberInSurah":1,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5477,"text":"قُمِ ٱلَّيْلَ إِلَّا قَلِيلًۭا","numberInSurah":2,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5478,"text":"نِّصْفَهُۥٓ أَوِ ٱنقُصْ مِنْهُ قَلِيلًا","numberInSurah":3,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5479,"text":"أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا","numberInSurah":4,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5480,"text":"إِنَّا سَنُلْقِى عَلَيْكَ قَوْلًۭا ثَقِيلًا","numberInSurah":5,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5481,"text":"إِنَّ نَاشِئَةَ ٱلَّيْلِ هِىَ أَشَدُّ وَطْـًۭٔا وَأَقْوَمُ قِيلًا","numberInSurah":6,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5482,"text":"إِنَّ لَكَ فِى ٱلنَّهَارِ سَبْحًۭا طَوِيلًۭا","numberInSurah":7,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5483,"text":"وَٱذْكُرِ ٱسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًۭا","numberInSurah":8,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5484,"text":"رَّبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذْهُ وَكِيلًۭا","numberInSurah":9,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5485,"text":"وَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱهْجُرْهُمْ هَجْرًۭا جَمِيلًۭا","numberInSurah":10,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5486,"text":"وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا","numberInSurah":11,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5487,"text":"إِنَّ لَدَيْنَآ أَنكَالًۭا وَجَحِيمًۭا","numberInSurah":12,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5488,"text":"وَطَعَامًۭا ذَا غُصَّةٍۢ وَعَذَابًا أَلِيمًۭا","numberInSurah":13,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5489,"text":"يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًۭا مَّهِيلًا","numberInSurah":14,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5490,"text":"إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًۭا شَٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًۭا","numberInSurah":15,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5491,"text":"فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَٰهُ أَخْذًۭا وَبِيلًۭا","numberInSurah":16,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5492,"text":"فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًۭا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا","numberInSurah":17,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5493,"text":"ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦ ۚ كَانَ وَعْدُهُۥ مَفْعُولًا","numberInSurah":18,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false},{"number":5494,"text":"إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا","numberInSurah":19,"surah":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Al-Muzzammil"},"juz":29,"sajda":false}]}