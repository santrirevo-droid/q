{"page":525,"ayahs":[{"number":4767,"text":"أَمْ تَأْمُرُهُمْ أَحْلَٰمُهُم بِهَٰذَآ ۚ أَمْ هُمْ قَوْمٌۭ طَاغُونَ","numberInSurah":32,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4768,"text":"أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ","numberInSurah":33,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4769,"text":"فَلْيَأْتُوا۟ بِحَدِيثٍۢ مِّثْلِهِۦٓ إِن كَانُوا۟ صَٰدِقِينَ","numberInSurah":34,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4770,"text":"أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَٰلِقُونَ","numberInSurah":35,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4771,"text":"أَمْ خَلَقُوا۟ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ","numberInSurah":36,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4772,"text":"أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ","numberInSurah":37,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4773,"text":"أَمْ لَهُمْ سُلَّمٌۭ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَٰنٍۢ مُّبِينٍ","numberInSurah":38,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4774,"text":"أَمْ لَهُ ٱلْبَنَٰتُ وَلَكُمُ ٱلْبَنُونَ","numberInSurah":39,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4775,"text":"أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ","numberInSurah":40,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4776,"text":"أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ","numberInSurah":41,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4777,"text":"أَمْ يُرِيدُونَ كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ","numberInSurah":42,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4778,"text":"أَمْ لَهُمْ إِلَٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ","numberInSurah":43,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4779,"text":"وَإِن يَرَوْا۟ كِسْفًۭا مِّنَ ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ","numberInSurah":44,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4780,"text":"فَذَرْهُمْ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ","numberInSurah":45,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4781,"text":"يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ","numberInSurah":46,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4782,"text":"وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":47,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4783,"text":"وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ","numberInSurah":48,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false},{"number":4784,"text":"وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَٰرَ ٱلنُّجُومِ","numberInSurah":49,"surah":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"At-Tur"},"juz":27,"sajda":false}]}