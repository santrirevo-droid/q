{"page":520,"ayahs":[{"number":4666,"text":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هُمْ أَشَدُّ مِنْهُم بَطْشًۭا فَنَقَّبُوا۟ فِى ٱلْبِلَٰدِ هَلْ مِن مَّحِيصٍ","numberInSurah":36,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4667,"text":"إِنَّ فِى ذَٰلِكَ لَذِكْرَىٰ لِمَن كَانَ لَهُۥ قَلْبٌ أَوْ أَلْقَى ٱلسَّمْعَ وَهُوَ شَهِيدٌۭ","numberInSurah":37,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4668,"text":"وَلَقَدْ خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍۢ وَمَا مَسَّنَا مِن لُّغُوبٍۢ","numberInSurah":38,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4669,"text":"فَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَسَبِّحْ بِحَمْدِ رَبِّكَ قَبْلَ طُلُوعِ ٱلشَّمْسِ وَقَبْلَ ٱلْغُرُوبِ","numberInSurah":39,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4670,"text":"وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَأَدْبَٰرَ ٱلسُّجُودِ","numberInSurah":40,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4671,"text":"وَٱسْتَمِعْ يَوْمَ يُنَادِ ٱلْمُنَادِ مِن مَّكَانٍۢ قَرِيبٍۢ","numberInSurah":41,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4672,"text":"يَوْمَ يَسْمَعُونَ ٱلصَّيْحَةَ بِٱلْحَقِّ ۚ ذَٰلِكَ يَوْمُ ٱلْخُرُوجِ","numberInSurah":42,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4673,"text":"إِنَّا نَحْنُ نُحْىِۦ وَنُمِيتُ وَإِلَيْنَا ٱلْمَصِيرُ","numberInSurah":43,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4674,"text":"يَوْمَ تَشَقَّقُ ٱلْأَرْضُ عَنْهُمْ سِرَاعًۭا ۚ ذَٰلِكَ حَشْرٌ عَلَيْنَا يَسِيرٌۭ","numberInSurah":44,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4675,"text":"نَّحْنُ أَعْلَمُ بِمَا يَقُولُونَ ۖ وَمَآ أَنتَ عَلَيْهِم بِجَبَّارٍۢ ۖ فَذَكِّرْ بِٱلْقُرْءَانِ مَن يَخَافُ وَعِيدِ","numberInSurah":45,"surah":{"number":50,"name":"سُورَةُ قٓ","englishName":"Qaaf"},"juz":26,"sajda":false},{"number":4676,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا","numberInSurah":1,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false},{"number":4677,"text":"فَٱلْحَٰمِلَٰتِ وِقْرًۭا","numberInSurah":2,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false},{"number":4678,"text":"فَٱلْجَٰرِيَٰتِ يُسْرًۭا","numberInSurah":3,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false},{"number":4679,"text":"فَٱلْمُقَسِّمَٰتِ أَمْرًا","numberInSurah":4,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false},{"number":4680,"text":"إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ","numberInSurah":5,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false},{"number":4681,"text":"وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ","numberInSurah":6,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":26,"sajda":false}]}