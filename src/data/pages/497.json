{"page":497,"ayahs":[{"number":4433,"text":"وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَٰنٍۢ مُّبِينٍۢ","numberInSurah":19,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4434,"text":"وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ","numberInSurah":20,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4435,"text":"وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ","numberInSurah":21,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4436,"text":"فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمٌۭ مُّجْرِمُونَ","numberInSurah":22,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4437,"text":"فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ","numberInSurah":23,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4438,"text":"وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌۭ مُّغْرَقُونَ","numberInSurah":24,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4439,"text":"كَمْ تَرَكُوا۟ مِن جَنَّٰتٍۢ وَعُيُونٍۢ","numberInSurah":25,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4440,"text":"وَزُرُوعٍۢ وَمَقَامٍۢ كَرِيمٍۢ","numberInSurah":26,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4441,"text":"وَنَعْمَةٍۢ كَانُوا۟ فِيهَا فَٰكِهِينَ","numberInSurah":27,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4442,"text":"كَذَٰلِكَ ۖ وَأَوْرَثْنَٰهَا قَوْمًا ءَاخَرِينَ","numberInSurah":28,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4443,"text":"فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ","numberInSurah":29,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4444,"text":"وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ","numberInSurah":30,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4445,"text":"مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًۭا مِّنَ ٱلْمُسْرِفِينَ","numberInSurah":31,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4446,"text":"وَلَقَدِ ٱخْتَرْنَٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَٰلَمِينَ","numberInSurah":32,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4447,"text":"وَءَاتَيْنَٰهُم مِّنَ ٱلْءَايَٰتِ مَا فِيهِ بَلَٰٓؤٌۭا۟ مُّبِينٌ","numberInSurah":33,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4448,"text":"إِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ","numberInSurah":34,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4449,"text":"إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ","numberInSurah":35,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4450,"text":"فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ","numberInSurah":36,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4451,"text":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍۢ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ","numberInSurah":37,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4452,"text":"وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ","numberInSurah":38,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4453,"text":"مَا خَلَقْنَٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":39,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false}]}