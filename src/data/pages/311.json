{"page":311,"ayahs":[{"number":2327,"text":"أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَٰتِنَا وَقَالَ لَأُوتَيَنَّ مَالًۭا وَوَلَدًا","numberInSurah":77,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2328,"text":"أَطَّلَعَ ٱلْغَيْبَ أَمِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا","numberInSurah":78,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2329,"text":"كَلَّا ۚ سَنَكْتُبُ مَا يَقُولُ وَنَمُدُّ لَهُۥ مِنَ ٱلْعَذَابِ مَدًّۭا","numberInSurah":79,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2330,"text":"وَنَرِثُهُۥ مَا يَقُولُ وَيَأْتِينَا فَرْدًۭا","numberInSurah":80,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2331,"text":"وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةًۭ لِّيَكُونُوا۟ لَهُمْ عِزًّۭا","numberInSurah":81,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2332,"text":"كَلَّا ۚ سَيَكْفُرُونَ بِعِبَادَتِهِمْ وَيَكُونُونَ عَلَيْهِمْ ضِدًّا","numberInSurah":82,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2333,"text":"أَلَمْ تَرَ أَنَّآ أَرْسَلْنَا ٱلشَّيَٰطِينَ عَلَى ٱلْكَٰفِرِينَ تَؤُزُّهُمْ أَزًّۭا","numberInSurah":83,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2334,"text":"فَلَا تَعْجَلْ عَلَيْهِمْ ۖ إِنَّمَا نَعُدُّ لَهُمْ عَدًّۭا","numberInSurah":84,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2335,"text":"يَوْمَ نَحْشُرُ ٱلْمُتَّقِينَ إِلَى ٱلرَّحْمَٰنِ وَفْدًۭا","numberInSurah":85,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2336,"text":"وَنَسُوقُ ٱلْمُجْرِمِينَ إِلَىٰ جَهَنَّمَ وِرْدًۭا","numberInSurah":86,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2337,"text":"لَّا يَمْلِكُونَ ٱلشَّفَٰعَةَ إِلَّا مَنِ ٱتَّخَذَ عِندَ ٱلرَّحْمَٰنِ عَهْدًۭا","numberInSurah":87,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2338,"text":"وَقَالُوا۟ ٱتَّخَذَ ٱلرَّحْمَٰنُ وَلَدًۭا","numberInSurah":88,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2339,"text":"لَّقَدْ جِئْتُمْ شَيْـًٔا إِدًّۭا","numberInSurah":89,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2340,"text":"تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِنْهُ وَتَنشَقُّ ٱلْأَرْضُ وَتَخِرُّ ٱلْجِبَالُ هَدًّا","numberInSurah":90,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2341,"text":"أَن دَعَوْا۟ لِلرَّحْمَٰنِ وَلَدًۭا","numberInSurah":91,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2342,"text":"وَمَا يَنۢبَغِى لِلرَّحْمَٰنِ أَن يَتَّخِذَ وَلَدًا","numberInSurah":92,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2343,"text":"إِن كُلُّ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ إِلَّآ ءَاتِى ٱلرَّحْمَٰنِ عَبْدًۭا","numberInSurah":93,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2344,"text":"لَّقَدْ أَحْصَىٰهُمْ وَعَدَّهُمْ عَدًّۭا","numberInSurah":94,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2345,"text":"وَكُلُّهُمْ ءَاتِيهِ يَوْمَ ٱلْقِيَٰمَةِ فَرْدًا","numberInSurah":95,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false}]}