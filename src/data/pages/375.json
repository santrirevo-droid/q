{"page":375,"ayahs":[{"number":3116,"text":"وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ","numberInSurah":184,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3117,"text":"قَالُوٓا۟ إِنَّمَآ أَنتَ مِنَ ٱلْمُسَحَّرِينَ","numberInSurah":185,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3118,"text":"وَمَآ أَنتَ إِلَّا بَشَرٌۭ مِّثْلُنَا وَإِن نَّظُنُّكَ لَمِنَ ٱلْكَٰذِبِينَ","numberInSurah":186,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3119,"text":"فَأَسْقِطْ عَلَيْنَا كِسَفًۭا مِّنَ ٱلسَّمَآءِ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","numberInSurah":187,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3120,"text":"قَالَ رَبِّىٓ أَعْلَمُ بِمَا تَعْمَلُونَ","numberInSurah":188,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3121,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ ٱلظُّلَّةِ ۚ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ","numberInSurah":189,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3122,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","numberInSurah":190,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3123,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","numberInSurah":191,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3124,"text":"وَإِنَّهُۥ لَتَنزِيلُ رَبِّ ٱلْعَٰلَمِينَ","numberInSurah":192,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3125,"text":"نَزَلَ بِهِ ٱلرُّوحُ ٱلْأَمِينُ","numberInSurah":193,"surah":{"num