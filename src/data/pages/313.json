{"page":313,"ayahs":[{"number":2361,"text":"وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ","numberInSurah":13,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2362,"text":"إِنَّنِىٓ أَنَا ٱللَّهُ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱعْبُدْنِى وَأَقِمِ ٱلصَّلَوٰةَ لِذِكْرِىٓ","numberInSurah":14,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2363,"text":"إِنَّ ٱلسَّاعَةَ ءَاتِيَةٌ أَكَادُ أُخْفِيهَا لِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا تَسْعَىٰ","numberInSurah":15,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2364,"text":"فَلَا يَصُدَّنَّكَ عَنْهَا مَن لَّا يُؤْمِنُ بِهَا وَٱتَّبَعَ هَوَىٰهُ فَتَرْدَىٰ","numberInSurah":16,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2365,"text":"وَمَا تِلْكَ بِيَمِينِكَ يَٰمُوسَىٰ","numberInSurah":17,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2366,"text":"قَالَ هِىَ عَصَاىَ أَتَوَكَّؤُا۟ عَلَيْهَا وَأَهُشُّ بِهَا عَلَىٰ غَنَمِى وَلِىَ فِيهَا مَـَٔارِبُ أُخْرَىٰ","numberInSurah":18,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2367,"text":"قَالَ أَلْقِهَا يَٰمُوسَىٰ","numberInSurah":19,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2368,"text":"فَأَلْقَىٰهَا فَإِذَا هِىَ حَيَّةٌۭ تَسْعَىٰ","numberInSurah":20,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2369,"text":"قَالَ خُذْهَا وَلَا تَخَفْ ۖ سَنُعِيدُهَا سِيرَتَهَا ٱلْأُولَىٰ","numberInSurah":21,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2370,"text":"وَٱضْمُمْ يَدَكَ إِلَىٰ جَنَاحِكَ تَخْرُجْ بَيْضَآءَ مِنْ غَيْرِ سُوٓءٍ ءَايَةً أُخْرَىٰ","numberInSurah":22,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2371,"text":"لِنُرِيَكَ مِنْ ءَايَٰتِنَا ٱلْكُبْرَى","numberInSurah":23,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2372,"text":"ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ","numberInSurah":24,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2373,"text":"قَالَ رَبِّ ٱشْرَحْ لِى صَدْرِى","numberInSurah":25,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2374,"text":"وَيَسِّرْ لِىٓ أَمْرِى","numberInSurah":26,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2375,"text":"وَٱحْلُلْ عُقْدَةًۭ مِّن لِّسَانِى","numberInSurah":27,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2376,"text":"يَفْقَهُوا۟ قَوْلِى","numberInSurah":28,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2377,"text":"وَٱجْعَل لِّى وَزِيرًۭا مِّنْ أَهْلِى","numberInSurah":29,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2378,"text":"هَٰرُونَ أَخِى","numberInSurah":30,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2379,"text":"ٱشْدُدْ بِهِۦٓ أَزْرِى","numberInSurah":31,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2380,"text":"وَأَشْرِكْهُ فِىٓ أَمْرِى","numberInSurah":32,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2381,"text":"كَىْ نُسَبِّحَكَ كَثِيرًۭا","numberInSurah":33,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2382,"text":"وَنَذْكُرَكَ كَثِيرًا","numberInSurah":34,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2383,"text":"إِنَّك