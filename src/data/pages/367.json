{"page":367,"ayahs":[{"number":2933,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طسٓمٓ","numberInSurah":1,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2934,"text":"تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ","numberInSurah":2,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2935,"text":"لَعَلَّكَ بَٰخِعٌۭ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","numberInSurah":3,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2936,"text":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةًۭ فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ","numberInSurah":4,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2937,"text":"وَمَا يَأْتِيهِم مِّن ذِكْرٍۢ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","numberInSurah":5,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2938,"text":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","numberInSurah":6,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2939,"text":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍۢ كَرِيمٍ","numberInSurah":7,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2940,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","numberInSurah":8,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2941,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","numberInSurah":9,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2942,"text":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ","numberInSurah":10,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2943,"text":"قَوْمَ فِرْعَوْنَ ۚ أَلَا يَتَّقُونَ","numberInSurah":11,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2944,"text":"قَالَ رَبِّ إِنِّىٓ أَخَافُ أَن يُكَذِّبُونِ","numberInSurah":12,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2945,"text":"وَيَضِيقُ صَدْرِى وَلَا يَنطَلِقُ لِسَانِى فَأَرْسِلْ إِلَىٰ هَٰرُونَ","numberInSurah":13,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2946,"text":"وَلَهُمْ عَلَىَّ ذَنۢبٌۭ فَأَخَافُ أَن يَقْتُلُونِ","numberInSurah":14,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2947,"text":"قَالَ كَلَّا ۖ فَٱذْهَبَا بِـَٔايَٰتِنَآ ۖ إِنَّا مَعَكُم مُّسْتَمِعُونَ","numberInSurah":15,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2948,"text":"فَأْتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلْعَٰلَمِينَ","numberInSurah":16,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2949,"text":"أَنْ أَرْسِلْ مَعَنَا بَنِىٓ إِسْرَٰٓءِيلَ","numberInSurah":17,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2950,"text":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيدًۭا وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ","numberInSurah":18,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2951,"text":"وَفَعَلْتَ فَعْلَتَكَ ٱلَّتِى فَعَلْتَ وَأَنتَ مِنَ ٱلْكَٰفِرِينَ","numberInSurah":19,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false}]}