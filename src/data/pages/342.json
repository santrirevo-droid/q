{"page":342,"ayahs":[{"number":2674,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قَدْ أَفْلَحَ ٱلْمُؤْمِنُونَ","numberInSurah":1,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2675,"text":"ٱلَّذِينَ هُمْ فِى صَلَاتِهِمْ خَٰشِعُونَ","numberInSurah":2,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2676,"text":"وَٱلَّذِينَ هُمْ عَنِ ٱللَّغْوِ مُعْرِضُونَ","numberInSurah":3,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2677,"text":"وَٱلَّذِينَ هُمْ لِلزَّكَوٰةِ فَٰعِلُونَ","numberInSurah":4,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2678,"text":"وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ","numberInSurah":5,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2679,"text":"إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ","numberInSurah":6,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2680,"text":"فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ","numberInSurah":7,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2681,"text":"وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ","numberInSurah":8,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2682,"text":"وَٱلَّذِينَ هُمْ عَلَىٰ صَلَوَٰتِهِمْ يُحَافِظُونَ","numberInSurah":9,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2683,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْوَٰرِثُونَ","numberInSurah":10,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2684,"text":"ٱلَّذِينَ يَرِثُونَ ٱلْفِرْدَوْسَ هُمْ فِيهَا خَٰلِدُونَ","numberInSurah":11,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2685,"text":"وَلَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ مِن سُلَٰلَةٍۢ مِّن طِينٍۢ","numberInSurah":12,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2686,"text":"ثُمَّ جَعَلْنَٰهُ نُطْفَةًۭ فِى قَرَارٍۢ مَّكِينٍۢ","numberInSurah":13,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2687,"text":"ثُمَّ خَلَقْنَا ٱلنُّطْفَةَ عَلَقَةًۭ فَخَلَقْنَا ٱلْعَلَقَةَ مُضْغَةًۭ فَخَلَقْنَا ٱلْمُضْغَةَ عِظَٰمًۭا فَكَسَوْنَا ٱلْعِظَٰمَ لَحْمًۭا ثُمَّ أَنشَأْنَٰهُ خَلْقًا ءَاخَرَ ۚ فَتَبَارَكَ ٱللَّهُ أَحْسَنُ ٱلْخَٰلِقِينَ","numberInSurah":14,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2688,"text":"ثُمَّ إِنَّكُم بَعْدَ ذَٰلِكَ لَمَيِّتُونَ","numberInSurah":15,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2689,"text":"ثُمَّ إِنَّكُمْ يَوْمَ ٱلْقِيَٰمَةِ تُبْعَثُونَ","numberInSurah":16,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false},{"number":2690,"text":"وَلَقَدْ خَلَقْنَا فَوْقَكُمْ سَبْعَ طَرَآئِقَ وَمَا كُنَّا عَنِ ٱلْخَلْقِ غَٰفِلِينَ","numberInSurah":17,"surah":{"number":23,"name":"سُورَةُ المُؤۡمِنُونَ","englishName":"Al-Muminoon"},"juz":18,"sajda":false}]}