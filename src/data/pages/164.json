{"page":164,"ayahs":[{"number":1059,"text":"حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ عَلَى ٱللَّهِ إِلَّا ٱلْحَقَّ ۚ قَدْ جِئْتُكُم بِبَيِّنَةٍۢ مِّن رَّبِّكُمْ فَأَرْسِلْ مَعِىَ بَنِىٓ إِسْرَٰٓءِيلَ","numberInSurah":105,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1060,"text":"قَالَ إِن كُنتَ جِئْتَ بِـَٔايَةٍۢ فَأْتِ بِهَآ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","numberInSurah":106,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1061,"text":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِىَ ثُعْبَانٌۭ مُّبِينٌۭ","numberInSurah":107,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1062,"text":"وَنَزَعَ يَدَهُۥ فَإِذَا هِىَ بَيْضَآءُ لِلنَّٰظِرِينَ","numberInSurah":108,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1063,"text":"قَالَ ٱلْمَلَأُ مِن قَوْمِ فِرْعَوْنَ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٌۭ","numberInSurah":109,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1064,"text":"يُرِيدُ أَن يُخْرِجَكُم مِّنْ أَرْضِكُمْ ۖ فَمَاذَا تَأْمُرُونَ","numberInSurah":110,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1065,"text":"قَالُوٓا۟ أَرْجِهْ وَأَخَاهُ وَأَرْسِلْ فِى ٱلْمَدَآئِنِ حَٰشِرِينَ","numberInSurah":111,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1066,"text":"يَأْتُوكَ بِكُلِّ سَٰحِرٍ عَلِيمٍۢ","numberInSurah":112,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1067,"text":"وَجَآءَ ٱلسَّحَرَةُ فِرْعَوْنَ قَالُوٓا۟ إِنَّ لَنَا لَأَجْرًا إِن كُنَّا نَحْنُ ٱلْغَٰلِبِينَ","numberInSurah":113,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1068,"text":"قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ ٱلْمُقَرَّبِينَ","numberInSurah":114,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1069,"text":"قَالُوا۟ يَٰمُوسَىٰٓ إِمَّآ أَن تُلْقِىَ وَإِمَّآ أَن نَّكُونَ نَحْنُ ٱلْمُلْقِينَ","numberInSurah":115,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1070,"text":"قَالَ أَلْقُوا۟ ۖ فَلَمَّآ أَلْقَوْا۟ سَحَرُوٓا۟ أَعْيُنَ ٱلنَّاسِ وَٱسْتَرْهَبُوهُمْ وَجَآءُو بِسِحْرٍ عَظِيمٍۢ","numberInSurah":116,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1071,"text":"۞ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ أَلْقِ عَصَاكَ ۖ فَإِذَا هِىَ تَلْقَفُ مَا يَأْفِكُونَ","numberInSurah":117,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1072,"text":"فَوَقَعَ ٱلْحَقُّ وَبَطَلَ مَا كَانُوا۟ يَعْمَلُونَ","numberInSurah":118,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1073,"text":"فَغُلِبُوا۟ هُنَالِكَ وَٱنقَلَبُوا۟ صَٰغِرِينَ","numberInSurah":119,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false},{"number":1074,"text":"وَأُلْقِىَ ٱلسَّحَرَةُ سَٰجِدِينَ","numberInSurah":120,"surah":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"Al-A'raaf"},"juz":9,"sajda":false}]}