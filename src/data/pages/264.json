{"page":264,"ayahs":[{"number":1834,"text":"قَالَ يَٰٓإِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ ٱلسَّٰجِدِينَ","numberInSurah":32,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1835,"text":"قَالَ لَمْ أَكُن لِّأَسْجُدَ لِبَشَرٍ خَلَقْتَهُۥ مِن صَلْصَٰلٍۢ مِّنْ حَمَإٍۢ مَّسْنُونٍۢ","numberInSurah":33,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1836,"text":"قَالَ فَٱخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌۭ","numberInSurah":34,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1837,"text":"وَإِنَّ عَلَيْكَ ٱللَّعْنَةَ إِلَىٰ يَوْمِ ٱلدِّينِ","numberInSurah":35,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1838,"text":"قَالَ رَبِّ فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ","numberInSurah":36,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1839,"text":"قَالَ فَإِنَّكَ مِنَ ٱلْمُنظَرِينَ","numberInSurah":37,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1840,"text":"إِلَىٰ يَوْمِ ٱلْوَقْتِ ٱلْمَعْلُومِ","numberInSurah":38,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1841,"text":"قَالَ رَبِّ بِمَآ أَغْوَيْتَنِى لَأُزَيِّنَنَّ لَهُمْ فِى ٱلْأَرْضِ وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ","numberInSurah":39,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1842,"text":"إِلَّا عِبَادَكَ مِنْهُمُ ٱلْمُخْلَصِينَ","numberInSurah":40,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1843,"text":"قَالَ هَٰذَا صِرَٰطٌ عَلَىَّ مُسْتَقِيمٌ","numberInSurah":41,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1844,"text":"إِنَّ عِبَادِى لَيْسَ لَكَ عَلَيْهِمْ سُلْطَٰنٌ إِلَّا مَنِ ٱتَّبَعَكَ مِنَ ٱلْغَاوِينَ","numberInSurah":42,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1845,"text":"وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ","numberInSurah":43,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1846,"text":"لَهَا سَبْعَةُ أَبْوَٰبٍۢ لِّكُلِّ بَابٍۢ مِّنْهُمْ جُزْءٌۭ مَّقْسُومٌ","numberInSurah":44,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1847,"text":"إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ","numberInSurah":45,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1848,"text":"ٱدْخُلُوهَا بِسَلَٰمٍ ءَامِنِينَ","numberInSurah":46,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1849,"text":"وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ إِخْوَٰنًا عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ","numberInSurah":47,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1850,"text":"لَا يَمَسُّهُمْ فِيهَا نَصَبٌۭ وَمَا هُم مِّنْهَا بِمُخْرَجِينَ","numberInSurah":48,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1851,"text":"۞ نَبِّئْ عِبَادِىٓ أَنِّىٓ أَنَا ٱلْغَفُورُ ٱلرَّحِيمُ","numberInSurah":49,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1852,"text":"وَأَنَّ عَذَابِى هُوَ ٱلْعَذَابُ ٱلْأَلِيمُ","numberInSurah":50,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1853,"text":"وَنَبِّئْهُمْ عَن ضَيْفِ إِبْرَٰهِيمَ","numberInSurah":51,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false}]}