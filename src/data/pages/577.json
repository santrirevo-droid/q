{"page":577,"ayahs":[{"number":5543,"text":"فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ","numberInSurah":48,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5544,"text":"فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ","numberInSurah":49,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5545,"text":"كَأَنَّهُمْ حُمُرٌۭ مُّسْتَنفِرَةٌۭ","numberInSurah":50,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5546,"text":"فَرَّتْ مِن قَسْوَرَةٍۭ","numberInSurah":51,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5547,"text":"بَلْ يُرِيدُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًۭا مُّنَشَّرَةًۭ","numberInSurah":52,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5548,"text":"كَلَّا ۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ","numberInSurah":53,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5549,"text":"كَلَّآ إِنَّهُۥ تَذْكِرَةٌۭ","numberInSurah":54,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5550,"text":"فَمَن شَآءَ ذَكَرَهُۥ","numberInSurah":55,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5551,"text":"وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ","numberInSurah":56,"surah":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Al-Muddaththir"},"juz":29,"sajda":false},{"number":5552,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ","numberInSurah":1,"surah":{"number":75,"name":"سُورَةُ القِيَامَةِ","englishName":"Al-Qiyaama"},"juz":29,"sajda":false},