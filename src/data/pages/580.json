{"page":580,"ayahs":[{"number":5617,"text":"وَمِنَ ٱلَّيْلِ فَٱسْجُدْ لَهُۥ وَسَبِّحْهُ لَيْلًۭا طَوِيلًا","numberInSurah":26,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5618,"text":"إِنَّ هَٰٓؤُلَآءِ يُحِبُّونَ ٱلْعَاجِلَةَ وَيَذَرُونَ وَرَآءَهُمْ يَوْمًۭا ثَقِيلًۭا","numberInSurah":27,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5619,"text":"نَّحْنُ خَلَقْنَٰهُمْ وَشَدَدْنَآ أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَآ أَمْثَٰلَهُمْ تَبْدِيلًا","numberInSurah":28,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5620,"text":"إِنَّ هَٰذِهِۦ تَذْكِرَةٌۭ ۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًۭا","numberInSurah":29,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5621,"text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ ۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًۭا","numberInSurah":30,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5622,"text":"يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦ ۚ وَٱلظَّٰلِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًۢا","numberInSurah":31,"surah":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"Al-Insaan"},"juz":29,"sajda":false},{"number":5623,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا","numberInSurah":1,"surah":{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat"},"juz":29,"sajda":false},{"number":5624,"text":"فَٱلْعَٰصِفَٰتِ عَصْفًۭا","numberInSurah":2,"surah":{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat"},"juz":29,"sajda":false},{"number":5625,"text":"وَٱلنَّٰشِرَٰتِ نَشْرًۭا","numberInSurah":3,"surah":{"number":77,"name":"سُورَةُ المُرۡسَلَاتِ","englishName":"Al-Mursalaat"},"juz":29,"sajda":false},{"number":5626,"text":"فَٱلْفَٰرِقَٰتِ فَرْقًۭا","numberI