{"page":564,"ayahs":[{"number":5268,"text":"فَلَمَّا رَأَوْهُ زُلْفَةًۭ سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ","numberInSurah":27,"surah":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Al-Mulk"},"juz":29,"sajda":false},{"number":5269,"text":"قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍۢ","numberInSurah":28,"surah":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Al-Mulk"},"juz":29,"sajda":false},{"number":5270,"text":"قُلْ هُوَ ٱلرَّحْمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَٰلٍۢ مُّبِينٍۢ","numberInSurah":29,"surah":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Al-Mulk"},"juz":29,"sajda":false},{"number":5271,"text":"قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًۭا فَمَن يَأْتِيكُم بِمَآءٍۢ مَّعِينٍۭ","numberInSurah":30,"surah":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Al-Mulk"},"juz":29,"sajda":false},{"number":5272,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ","numberInSurah":1,"surah":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam"},"juz":29,"sajda":false},{"number":5273,"text":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ","numberInSurah":2,"surah":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam"},"juz":29,"sajda":false},{"number":5274,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ","numberInSurah":3,"surah":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam"},"juz":29,"sajda":false},{"number":5275,"text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ","numberInSurah":4,"surah":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam"},"juz":29,"sajda":false},{"number":5276,"text":"فَسَتُبْصِرُ وَيُبْصِرُونَ","numberInSurah":5,"surah":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Al-Qalam"},"juz":29,"sajda":false},{"number":5277,"text":"بِأَييِّكُمُ ٱلْمَفْتُونُ","numberInSurah":6,"