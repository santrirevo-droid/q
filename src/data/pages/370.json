{"page":370,"ayahs":[{"number":2993,"text":"فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَٰبُ مُوسَىٰٓ إِنَّا لَمُدْرَكُونَ","numberInSurah":61,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2994,"text":"قَالَ كَلَّآ ۖ إِنَّ مَعِىَ رَبِّى سَيَهْدِينِ","numberInSurah":62,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2995,"text":"فَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْبَحْرَ ۖ فَٱنفَلَقَ فَكَانَ كُلُّ فِرْقٍۢ كَٱلطَّوْدِ ٱلْعَظِيمِ","numberInSurah":63,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2996,"text":"وَأَزْلَفْنَا ثَمَّ ٱلْءَاخَرِينَ","numberInSurah":64,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2997,"text":"وَأَنجَيْنَا مُوسَىٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ","numberInSurah":65,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2998,"text":"ثُمَّ أَغْرَقْنَا ٱلْءَاخَرِينَ","numberInSurah":66,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":2999,"text":"إِنَّ فِى ذَٰلِكَ لَءَايَةًۭ ۖ وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","numberInSurah":67,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3000,"text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","numberInSurah":68,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3001,"text":"وَٱتْلُ عَلَيْهِمْ نَبَأَ إِبْرَٰهِيمَ","numberInSurah":69,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3002,"text":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَ","numberInSurah":70,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3003,"text":"قَالُوا۟ نَعْبُدُ أَصْنَامًۭا فَنَظَلُّ لَهَا عَٰكِفِينَ","numberInSurah":71,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3004,"text":"قَالَ هَلْ يَسْمَعُونَكُمْ إِذْ تَدْعُونَ","numberInSurah":72,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3005,"text":"أَوْ يَنفَعُونَكُمْ أَوْ يَضُرُّونَ","numberInSurah":73,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3006,"text":"قَالُوا۟ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَ","numberInSurah":74,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3007,"text":"قَالَ أَفَرَءَيْتُم مَّا كُنتُمْ تَعْبُدُونَ","numberInSurah":75,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3008,"text":"أَنتُمْ وَءَابَآؤُكُمُ ٱلْأَقْدَمُونَ","numberInSurah":76,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3009,"text":"فَإِنَّهُمْ عَدُوٌّۭ لِّىٓ إِلَّا رَبَّ ٱلْعَٰلَمِينَ","numberInSurah":77,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3010,"text":"ٱلَّذِى خَلَقَنِى فَهُوَ يَهْدِينِ","numberInSurah":78,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3011,"text":"وَٱلَّذِى هُوَ يُطْعِمُنِى وَيَسْقِينِ","numberInSurah":79,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3012,"text":"وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ","numberInSurah":80,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3013,"text":"وَٱلَّذِى يُمِيتُنِى ثُمَّ يُحْيِينِ","numberInSurah":81,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3014,"text":"وَٱلَّذِىٓ أَطْمَعُ أَن يَغْفِرَ لِى خَطِيٓـَٔتِى يَوْمَ ٱلدِّينِ","numberInSurah":82,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false},{"number":3015,"text":"رَبِّ هَبْ لِى حُكْمًۭا وَأَلْحِقْنِى بِٱلصَّٰلِحِينَ","numberInSurah":83,"surah":{"number":26,"name":"سُورَةُ الشُّعَرَاءِ","englishName":"Ash-Shu'araa"},"juz":19,"sajda":false}]}