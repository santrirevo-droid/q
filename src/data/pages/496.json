{"page":496,"ayahs":[{"number":4415,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ","numberInSurah":1,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4416,"text":"وَٱلْكِتَٰبِ ٱلْمُبِينِ","numberInSurah":2,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4417,"text":"إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ","numberInSurah":3,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4418,"text":"فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ","numberInSurah":4,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4419,"text":"أَمْرًۭا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ","numberInSurah":5,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4420,"text":"رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ","numberInSurah":6,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4421,"text":"رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ","numberInSurah":7,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4422,"text":"لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ","numberInSurah":8,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4423,"text":"بَلْ هُمْ فِى شَكٍّۢ يَلْعَبُونَ","numberInSurah":9,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4424,"text":"فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍۢ مُّبِينٍۢ","numberInSurah":10,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4425,"text":"يَغْشَى ٱلنَّاسَ ۖ هَٰذَا عَذَابٌ أَلِيمٌۭ","numberInSurah":11,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4426,"text":"رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ","numberInSurah":12,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4427,"text":"أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌۭ مُّبِينٌۭ","numberInSurah":13,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4428,"text":"ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ مَّجْنُونٌ","numberInSurah":14,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4429,"text":"إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ","numberInSurah":15,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4430,"text":"يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ","numberInSurah":16,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4431,"text":"۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌۭ كَرِيمٌ","numberInSurah":17,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4432,"text":"أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ","numberInSurah":18,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false}]}