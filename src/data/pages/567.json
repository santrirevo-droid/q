{"page":567,"ayahs":[{"number":5332,"text":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","numberInSurah":9,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5333,"text":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً","numberInSurah":10,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5334,"text":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","numberInSurah":11,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5335,"text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ","numberInSurah":12,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5336,"text":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ","numberInSurah":13,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5337,"text":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ","numberInSurah":14,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5338,"text":"فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ","numberInSurah":15,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5339,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ","numberInSurah":16,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5340,"text":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ","numberInSurah":17,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5341,"text":"يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ","numberInSurah":18,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5342,"text":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ","numberInSurah":19,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5343,"text":"إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ","numberInSurah":20,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5344,"text":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","numberInSurah":21,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5345,"text":"فِى جَنَّةٍ عَالِيَةٍۢ","numberInSurah":22,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5346,"text":"قُطُوفُهَا دَانِيَةٌۭ","numberInSurah":23,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5347,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","numberInSurah":24,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5348,"text":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ","numberInSurah":25,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5349,"text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","numberInSurah":26,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5350,"text":"يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ","numberInSurah":27,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5351,"text":"مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ","numberInSurah":28,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5352,"text":"هَلَكَ عَنِّى سُلْطَٰنِيَهْ","numberInSurah":29,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5353,"text":"خُذُوهُ فَغُلُّوهُ","numberInSurah":30,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5354,"text":"ثُمَّ ٱلْجَحِيمَ صَلُّوهُ","numberInSurah":31,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5355,"text":"ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ","numberInSurah":32,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5356,"text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ","numberInSurah":33,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false},{"number":5357,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","numberInSurah":34,"surah":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Al-Haaqqa"},"juz":29,"sajda":false}]}