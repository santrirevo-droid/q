{"page":599,"ayahs":[{"number":6138,"text":"جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍۢ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًۭا ۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ ۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ","numberInSurah":8,"surah":{"number":98,"name":"سُورَةُ البَيِّنَةِ","englishName":"Al-Bayyina"},"juz":30,"sajda":false},{"number":6139,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","numberInSurah":1,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6140,"text":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","numberInSurah":2,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6141,"text":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","numberInSurah":3,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6142,"text":"يَوْمَئِذٍۢ تُحَدِّثُ أَخْبَارَهَا","numberInSurah":4,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","numberInSurah":5,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6144,"text":"يَوْمَئِذٍۢ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًۭا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","numberInSurah":6,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6145,"text":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًۭا يَرَهُۥ","numberInSurah":7,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6146,"text":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍۢ شَرًّۭا يَرَهُۥ","numberInSurah":8,"surah":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Az-Zalzala"},"juz":30,"sajda":false},{"number":6147,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","numberInSurah