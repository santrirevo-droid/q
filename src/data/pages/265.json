{"page":265,"ayahs":[{"number":1854,"text":"إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا قَالَ إِنَّا مِنكُمْ وَجِلُونَ","numberInSurah":52,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1855,"text":"قَالُوا۟ لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَٰمٍ عَلِيمٍۢ","numberInSurah":53,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1856,"text":"قَالَ أَبَشَّرْتُمُونِى عَلَىٰٓ أَن مَّسَّنِىَ ٱلْكِبَرُ فَبِمَ تُبَشِّرُونَ","numberInSurah":54,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1857,"text":"قَالُوا۟ بَشَّرْنَٰكَ بِٱلْحَقِّ فَلَا تَكُن مِّنَ ٱلْقَٰنِطِينَ","numberInSurah":55,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1858,"text":"قَالَ وَمَن يَقْنَطُ مِن رَّحْمَةِ رَبِّهِۦٓ إِلَّا ٱلضَّآلُّونَ","numberInSurah":56,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1859,"text":"قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ","numberInSurah":57,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1860,"text":"قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ","numberInSurah":58,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1861,"text":"إِلَّآ ءَالَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ","numberInSurah":59,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1862,"text":"إِلَّا ٱمْرَأَتَهُۥ قَدَّرْنَآ ۙ إِنَّهَا لَمِنَ ٱلْغَٰبِرِينَ","numberInSurah":60,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1863,"text":"فَلَمَّا جَآءَ ءَالَ لُوطٍ ٱلْمُرْسَلُونَ","numberInSurah":61,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1864,"text":"قَالَ إِنَّكُمْ قَوْمٌۭ مُّنكَرُونَ","numberInSurah":62,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1865,"text":"قَالُوا۟ بَلْ جِئْنَٰكَ بِمَا كَانُوا۟ فِيهِ يَمْتَرُونَ","numberInSurah":63,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1866,"text":"وَأَتَيْنَٰكَ بِٱلْحَقِّ وَإِنَّا لَصَٰدِقُونَ","numberInSurah":64,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1867,"text":"فَأَسْرِ بِأَهْلِكَ بِقِطْعٍۢ مِّنَ ٱلَّيْلِ وَٱتَّبِعْ أَدْبَٰرَهُمْ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌۭ وَٱمْضُوا۟ حَيْثُ تُؤْمَرُونَ","numberInSurah":65,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1868,"text":"وَقَضَيْنَآ إِلَيْهِ ذَٰلِكَ ٱلْأَمْرَ أَنَّ دَابِرَ هَٰٓؤُلَآءِ مَقْطُوعٌۭ مُّصْبِحِينَ","numberInSurah":66,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1869,"text":"وَجَآءَ أَهْلُ ٱلْمَدِينَةِ يَسْتَبْشِرُونَ","numberInSurah":67,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1870,"text":"قَالَ إِنَّ هَٰٓؤُلَآءِ ضَيْفِى فَلَا تَفْضَحُونِ","numberInSurah":68,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1871,"text":"وَٱتَّقُوا۟ ٱللَّهَ وَلَا تُخْزُونِ","numberInSurah":69,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false},{"number":1872,"text":"قَالُوٓا۟ أَوَلَمْ نَنْهَكَ عَنِ ٱلْعَٰلَمِينَ","numberInSurah":70,"surah":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Al-Hijr"},"juz":14,"sajda":false}]}