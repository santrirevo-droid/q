{"page":571,"ayahs":[{"number":5430,"text":"يُرْسِلِ ٱلسَّمَآءَ عَلَيْكُم مِّدْرَارًۭا","numberInSurah":11,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5431,"text":"وَيُمْدِدْكُم بِأَمْوَٰلٍۢ وَبَنِينَ وَيَجْعَل لَّكُمْ جَنَّٰتٍۢ وَيَجْعَل لَّكُمْ أَنْهَٰرًۭا","numberInSurah":12,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5432,"text":"مَّا لَكُمْ لَا تَرْجُونَ لِلَّهِ وَقَارًۭا","numberInSurah":13,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5433,"text":"وَقَدْ خَلَقَكُمْ أَطْوَارًا","numberInSurah":14,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5434,"text":"أَلَمْ تَرَوْا۟ كَيْفَ خَلَقَ ٱللَّهُ سَبْعَ سَمَٰوَٰتٍۢ طِبَاقًۭا","numberInSurah":15,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5435,"text":"وَجَعَلَ ٱلْقَمَرَ فِيهِنَّ نُورًۭا وَجَعَلَ ٱلشَّمْسَ سِرَاجًۭا","numberInSurah":16,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5436,"text":"وَٱللَّهُ أَنۢبَتَكُم مِّنَ ٱلْأَرْضِ نَبَاتًۭا","numberInSurah":17,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5437,"text":"ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًۭا","numberInSurah":18,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5438,"text":"وَٱللَّهُ جَعَلَ لَكُمُ ٱلْأَرْضَ بِسَاطًۭا","numberInSurah":19,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5439,"text":"لِّتَسْلُكُوا۟ مِنْهَا سُبُلًۭا فِجَاجًۭا","numberInSurah":20,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5440,"text":"قَالَ نُوحٌۭ رَّبِّ إِنَّهُمْ عَصَوْنِى وَٱتَّبَعُوا۟ مَن لَّمْ يَزِدْهُ مَالُهُۥ وَوَلَدُهُۥٓ إِلَّا خَسَارًۭا","numberInSurah":21,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5441,"text":"وَمَكَرُوا۟ مَكْرًۭا كُبَّارًۭا","numberInSurah":22,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5442,"text":"وَقَالُوا۟ لَا تَذَرُنَّ ءَالِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّۭا وَلَا سُوَاعًۭا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًۭا","numberInSurah":23,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5443,"text":"وَقَدْ أَضَلُّوا۟ كَثِيرًۭا ۖ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا ضَلَٰلًۭا","numberInSurah":24,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5444,"text":"مِّمَّا خَطِيٓـَٰٔتِهِمْ أُغْرِقُوا۟ فَأُدْخِلُوا۟ نَارًۭا فَلَمْ يَجِدُوا۟ لَهُم مِّن دُونِ ٱللَّهِ أَنصَارًۭا","numberInSurah":25,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5445,"text":"وَقَالَ نُوحٌۭ رَّبِّ لَا تَذَرْ عَلَى ٱلْأَرْضِ مِنَ ٱلْكَٰفِرِينَ دَيَّارًا","numberInSurah":26,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5446,"text":"إِنَّكَ إِن تَذَرْهُمْ يُضِلُّوا۟ عِبَادَكَ وَلَا يَلِدُوٓا۟ إِلَّا فَاجِرًۭا كَفَّارًۭا","numberInSurah":27,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false},{"number":5447,"text":"رَّبِّ ٱغْفِرْ لِى وَلِوَٰلِدَىَّ وَلِمَن دَخَلَ بَيْتِىَ مُؤْمِنًۭا وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ وَلَا تَزِدِ ٱلظَّٰلِمِينَ إِلَّا تَبَارًۢا","numberInSurah":28,"surah":{"number":71,"name":"سُورَةُ نُوحٍ","englishName":"Nooh"},"juz":29,"sajda":false}]}