{"page":498,"ayahs":[{"number":4454,"text":"إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ","numberInSurah":40,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4455,"text":"يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ","numberInSurah":41,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4456,"text":"إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","numberInSurah":42,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4457,"text":"إِنَّ شَجَرَتَ ٱلزَّقُّومِ","numberInSurah":43,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4458,"text":"طَعَامُ ٱلْأَثِيمِ","numberInSurah":44,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4459,"text":"كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ","numberInSurah":45,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4460,"text":"كَغَلْىِ ٱلْحَمِيمِ","numberInSurah":46,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4461,"text":"خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ","numberInSurah":47,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4462,"text":"ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ","numberInSurah":48,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4463,"text":"ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ","numberInSurah":49,"surah":{"number":44,"name":"سُورَةُ الدُّخَانِ","englishName":"Ad-Dukhaan"},"juz":25,"sajda":false},{"number":4464,"text":"إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ","numberInSurah":50,"surah":{"number":44,"