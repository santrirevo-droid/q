{"page":312,"ayahs":[{"number":2346,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَيَجْعَلُ لَهُمُ ٱلرَّحْمَٰنُ وُدًّۭا","numberInSurah":96,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2347,"text":"فَإِنَّمَا يَسَّرْنَٰهُ بِلِسَانِكَ لِتُبَشِّرَ بِهِ ٱلْمُتَّقِينَ وَتُنذِرَ بِهِۦ قَوْمًۭا لُّدًّۭا","numberInSurah":97,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2348,"text":"وَكَمْ أَهْلَكْنَا قَبْلَهُم مِّن قَرْنٍ هَلْ تُحِسُّ مِنْهُم مِّنْ أَحَدٍ أَوْ تَسْمَعُ لَهُمْ رِكْزًۢا","numberInSurah":98,"surah":{"number":19,"name":"سُورَةُ مَرۡيَمَ","englishName":"Maryam"},"juz":16,"sajda":false},{"number":2349,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طه","numberInSurah":1,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2350,"text":"مَآ أَنزَلْنَا عَلَيْكَ ٱلْقُرْءَانَ لِتَشْقَىٰٓ","numberInSurah":2,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2351,"text":"إِلَّا تَذْكِرَةًۭ لِّمَن يَخْشَىٰ","numberInSurah":3,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2352,"text":"تَنزِيلًۭا مِّمَّنْ خَلَقَ ٱلْأَرْضَ وَٱلسَّمَٰوَٰتِ ٱلْعُلَى","numberInSurah":4,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2353,"text":"ٱلرَّحْمَٰنُ عَلَى ٱلْعَرْشِ ٱسْتَوَىٰ","numberInSurah":5,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2354,"text":"لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَمَا بَيْنَهُمَا وَمَا تَحْتَ ٱلثَّرَىٰ","numberInSurah":6,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2355,"text":"وَإِن تَجْهَرْ بِٱلْقَوْلِ فَإِنَّهُۥ يَعْلَمُ ٱلسِّرَّ وَأَخْفَى","numberInSurah":7,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2356,"text":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ۖ لَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ","numberInSurah":8,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2357,"text":"وَهَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","numberInSurah":9,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2358,"text":"إِذْ رَءَا نَارًۭا فَقَالَ لِأَهْلِهِ ٱمْكُثُوٓا۟ إِنِّىٓ ءَانَسْتُ نَارًۭا لَّعَلِّىٓ ءَاتِيكُم مِّنْهَا بِقَبَسٍ أَوْ أَجِدُ عَلَى ٱلنَّارِ هُدًۭى","numberInSurah":10,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2359,"text":"فَلَمَّآ أَتَىٰهَا نُودِىَ يَٰمُوسَىٰٓ","numberInSurah":11,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false},{"number":2360,"text":"إِنِّىٓ أَنَا۠ رَبُّكَ فَٱخْلَعْ نَعْلَيْكَ ۖ إِنَّكَ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًۭى","numberInSurah":12,"surah":{"number":20,"name":"سُورَةُ طه","englishName":"Taa-Haa"},"juz":16,"sajda":false}]}