{"page":523,"ayahs":[{"number":4727,"text":"كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ","numberInSurah":52,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4728,"text":"أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ","numberInSurah":53,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4729,"text":"فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ","numberInSurah":54,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4730,"text":"وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ","numberInSurah":55,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4731,"text":"وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ","numberInSurah":56,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4732,"text":"مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ","numberInSurah":57,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4733,"text":"إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ","numberInSurah":58,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4734,"text":"فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ","numberInSurah":59,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4735,"text":"فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ","numberInSurah":60,"surah":{"number":51,"name":"سُورَةُ الذَّارِيَاتِ","englishName":"Adh-Dhaariyat"},"juz":27,"sajda":false},{"number":4736,"text":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ